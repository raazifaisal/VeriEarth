# VeriEarth Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database
# For Docker: postgresql+psycopg2://postgres:password@postgres:5432/veriearth
# For Local: postgresql://postgres:password@localhost:5432/veriearth
DATABASE_URL=postgresql://postgres:password@localhost:5432/veriearth

# ============================================
# Neo4j Graph Database Configuration
# ============================================

# Neo4j Connection URI
# Format: bolt://host:port
# For Docker: bolt://neo4j:7687
# For Local: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j Username
NEO4J_USER=neo4j

# Neo4j Password
NEO4J_PASSWORD=12345678

# ============================================
# Redis Cache Configuration
# ============================================

# Redis Connection URL
# Format: redis://host:port
# For Docker: redis://redis:6379
# For Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Google Earth Engine Configuration
# ============================================

# GEE Project ID (from Google Cloud Console)
GEE_PROJECT_ID=veriearth-468117

# Path to GEE Service Account JSON Key File
# Required for EO data enrichment
# For Docker: /app/service-account-key.json
# For Local: ./service-account-key.json
GEE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# GEE Service Account Email
# Format: service-account@project-id.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=veriearth-containeraccount@veriearth-468117.iam.gserviceaccount.com

# EO Facility Buffer (kilometers)
# Radius around facility for EO data collection
EO_FACILITY_BUFFER_KM=5

# Auto-enrich facilities with EO data
# Set to "true" to automatically fetch EO data on facility creation
EO_AUTO_ENRICH=true

# ============================================
# Authentication & Security
# ============================================

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT Access Token Expiration (minutes)
# Default: 30 minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Optional Configuration
# ============================================

# JWT Algorithm (usually doesn't need to change)
# JWT_ALGORITHM=HS256
